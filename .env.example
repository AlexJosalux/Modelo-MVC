# Copie este archivo como ".env" y ajuste los valores segun su entorno.
# NUNCA suba el archivo ".env" real a un repositorio publico (ver .gitignore).

# Puerto en el que escucha la aplicacion
PORT=3000

# URL base de la API REST que consume la aplicacion (gestion de servicios)
API_BASE_URL=https://api.restful-api.dev/objects

# Tiempo maximo (ms) de espera por respuesta de la API externa
API_TIMEOUT_MS=5000

# Clave secreta usada para firmar la sesion y los tokens CSRF.
# Genere una propia con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambie_esta_clave_por_una_generada_aleatoriamente

# Entorno de ejecucion: development | production
NODE_ENV=development
