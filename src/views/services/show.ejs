<h1><%= service.name %></h1>

<table>
  <tbody>
    <tr><th>ID</th><td><%= service.id %></td></tr>
    <tr><th>Categoría</th><td><%= service.category %></td></tr>
    <tr><th>Precio</th><td><%= service.price !== null ? '$' + service.price : '-' %></td></tr>
    <tr><th>Disponible</th><td><%= service.available ? 'Sí' : 'No' %></td></tr>
    <tr><th>Notas</th><td><%= service.notes || '-' %></td></tr>
  </tbody>
</table>

<p style="margin-top:16px;">
  <a class="btn btn-secondary" href="/services">&larr; Volver al listado</a>
  <a class="btn btn-primary" href="/services/<%= service.id %>/edit">Editar</a>
</p>
