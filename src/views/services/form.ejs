<h1><%= title %></h1>

<% if (errors && errors.length) { %>
  <div class="error-list">
    <strong>Se encontraron los siguientes errores:</strong>
    <ul>
      <% errors.forEach(function(e) { %>
        <li><%= e.msg %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<form method="POST" action="<%= formAction %>" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <div class="form-group">
    <label for="name">Nombre del servicio</label>
    <input type="text" id="name" name="name" value="<%= service.name || '' %>" required maxlength="120" />
  </div>

  <div class="form-group">
    <label for="category">Categoría</label>
    <input type="text" id="category" name="category" value="<%= service.category || '' %>" required maxlength="60" />
  </div>

  <div class="form-group">
    <label for="price">Precio (USD)</label>
    <input type="number" id="price" name="price" step="0.01" min="0" value="<%= service.price ?? '' %>" required />
  </div>

  <div class="form-group">
    <label>
      <input type="checkbox" name="available" <%= service.available ? 'checked' : '' %> style="width:auto; display:inline-block; margin-right:6px;" />
      Servicio disponible actualmente
    </label>
  </div>

  <div class="form-group">
    <label for="notes">Notas</label>
    <textarea id="notes" name="notes" rows="3" maxlength="500"><%= service.notes || '' %></textarea>
  </div>

  <button class="btn btn-primary" type="submit">Guardar</button>
  <a class="btn btn-secondary" href="/services">Cancelar</a>
</form>
